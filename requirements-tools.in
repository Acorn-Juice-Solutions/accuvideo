# Tooling for .minify_main.py, which produces assets/js/main.min.js.
#
# This dependency existed but was never declared anywhere: rjsmin was installed
# into a local .venv by hand, so the minifier that produces a file served to
# every visitor had no pinned, verifiable version. Anyone reproducing the build
# would have got whatever rjsmin was current that day.
#
# Regenerate requirements-tools.txt after editing:
#   uv pip compile requirements-tools.in --generate-hashes \
#       --python-version 3.13 --python-platform windows -o requirements-tools.txt
#
# Install with:
#   pip install --require-hashes --no-deps -r requirements-tools.txt

rjsmin==1.2.5
